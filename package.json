{
  "name": "lightning-split",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "setup:dev-secret": "node scripts/setup-dev-secret.mjs",
    "dev:worker": "npm run build && wrangler dev --local --live-reload",
    "preview:mobile": "npm run build && wrangler dev --local --ip 0.0.0.0 --port 8787",
    "preview:tunnel": "npm run build && wrangler dev --local --tunnel",
    "build": "vite build",
    "postbuild": "node scripts/deploy-runtime-preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:worker && npm run build && npm run worker:dry-run"
  },
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@scure/base": "2.3.0",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@eslint/js": "^10.0.1",
    "@msw/cloudflare": "^0.0.1",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "msw": "^2.15.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.127.1"
  }
}
