/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://api.upbit.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/sw.js
  Cache-Control: no-store, max-age=0, must-revalidate

/app-sw.js
  Cache-Control: no-store, max-age=0, must-revalidate

/build.json
  Cache-Control: no-store, max-age=0, must-revalidate
